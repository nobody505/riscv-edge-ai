# Copy to /etc/elder-assistant/elder.env and chmod 600.
# systemd EnvironmentFile syntax: do not add spaces around '='.
ONENET_PRODUCT_ID=REPLACE_WITH_ONENET_PRODUCT_ID
ONENET_DEVICE_NAME=REPLACE_WITH_ONENET_DEVICE_NAME
ONENET_DEVICE_KEY_B64=REPLACE_WITH_ONENET_DEVICE_KEY_BASE64
ONENET_PRODUCT_KEY_B64=REPLACE_WITH_ONENET_PRODUCT_KEY_BASE64
TENCENT_MAP_KEY=REPLACE_WITH_TENCENT_MAP_KEY
ELDER_SMS_PHONE=REPLACE_WITH_TRUSTED_MOBILE_NUMBER
ELDER_SMS_CONTACT_NAME=紧急联系人
